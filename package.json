{
  "name": "topic-research-pack",
  "version": "0.1.0",
  "description": "Topic research pack: trending news, keyword ideas and clean page text from one input. Apify Actor, MCP server and CLI.",
  "license": "MIT",
  "author": "Amit Gaikwad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitgaikwad2837/topic-research-pack.git"
  },
  "homepage": "https://github.com/amitgaikwad2837/topic-research-pack#readme",
  "bugs": {
    "url": "https://github.com/amitgaikwad2837/topic-research-pack/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "apify",
    "apify-actor",
    "research",
    "news",
    "trends",
    "keywords",
    "rag",
    "ai-agents"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "topic-research": "dist/cli.js",
    "topic-research-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp-server.ts",
    "start": "npm run start:dev",
    "start:dev": "tsx src/actor.ts",
    "start:prod": "node dist/actor.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "apify": "^3.7.2",
    "fast-xml-parser": "^5.12.1",
    "linkedom": "^0.18.15",
    "turndown": "^7.2.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.6"
  }
}
